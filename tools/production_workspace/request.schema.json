{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "puzzle_id",
    "revision",
    "record",
    "title",
    "assets",
    "offers"
  ],
  "properties": {
    "format": {
      "enum": ["picross-production-presentation-request-v1", "picross-production-presentation-request-v2"]
    },
    "puzzle_id": {
      "type": "string",
      "pattern": "^pz-[a-z0-9][a-z0-9-]{0,59}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,31}$"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "file"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "assets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "caption",
          "location"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "role": {
            "enum": [
              "reveal",
              "motif",
              "raster",
              "raster_draft",
              "background"
            ]
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commit",
              "storage",
              "container",
              "file"
            ],
            "properties": {
              "commit": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{40}$"
              },
              "storage": {
                "enum": [
                  "repository",
                  "package"
                ]
              },
              "container": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 240
              },
              "file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            }
          }
        }
      }
    },
    "offers": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "record",
          "asset_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "kind": {
            "enum": [
              "reveal",
              "raster",
              "background"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "record": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commit",
              "file"
            ],
            "properties": {
              "commit": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{40}$"
              },
              "file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            }
          },
          "asset_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            }
          }
        }
      }
    }
  }
}
