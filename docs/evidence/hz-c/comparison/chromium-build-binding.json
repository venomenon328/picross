  "entry": "extends Control\nconst Sample = preload(\"res://ui/hzc_sample.gd\")\nconst Text = preload(\"res://ui/ui_text.gd\")\nvar sample: Control\nfunc _ready() -> void:\n get_viewport().size_changed.connect(build)\n build()\nfunc build() -> void:\n if sample != null: sample.free()\n var u: float = 1.0 if get_viewport_rect().size.x == 1920 else 1.25\n theme = Theme.new()\n theme.default_font = Text.font()\n theme.default_font_size = roundi(14*u)\n theme.set_stylebox(\"normal\",\"Label\",Text.label_style(u))\n theme.set_constant(\"line_spacing\",\"Label\",roundi(3*u))\n theme.set_color(\"font_color\",\"Label\",Color(\"293e3d\"))\n theme.set_color(\"font_color\",\"Button\",Color(\"293e3d\"))\n sample = Sample.new()\n sample.position = Vector2(24,24)\n sample.ui_scale = u\n add_child(sample)\nfunc _process(_delta: float) -> void:\n var controls: Array = []\n for node: Node in sample.get_children():\n  if node is OptionButton:\n   var rect: Rect2 = node.get_global_rect()\n   controls.append({\"center\":[rect.get_center().x,rect.get_center().y],\"visible\":node.get_popup().visible})\n var r: Rect2 = sample.get_global_rect()\n JavaScriptBridge.eval(\"window.hzcComparison = \"+JSON.stringify({\"controls\":controls,\"rect\":[r.position.x,r.position.y,r.size.x,r.size.y]}),true)\n",
